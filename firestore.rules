rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(businessId) {
      return isSignedIn() && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }

    function getMemberRole(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.role;
    }

    function isOwner(businessId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/businesses/$(businessId)) && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid) ||
        (isMember(businessId) && getMemberRole(businessId) == 'owner')
      );
    }

    function isOwnerOrAdmin(businessId) {
      return isOwner(businessId) || (isMember(businessId) && getMemberRole(businessId) == 'admin');
    }

    // User profiles (read & write own profile)
    match /users/{userId} {
      allow read, write: if isUser(userId);
    }

    // Collection group query for user memberships across all businesses
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Collection group query for invoices across all businesses
    match /{path=**}/invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Tenant Business Workspace
    match /businesses/{businessId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isOwnerOrAdmin(businessId));
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isOwner(businessId));

      // Members subcollection
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if isSignedIn();
      }

      // Clients subcollection
      match /clients/{clientId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      // Service Catalog subcollection
      match /serviceCatalog/{serviceId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      // Invoices subcollection
      match /invoices/{invoiceId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      // Payments subcollection
      match /payments/{paymentId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      // Settings subcollection
      match /settings/{settingId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      // Audit logs
      match /auditLogs/{logId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // Invitations
    match /invitations/{invitationId} {
      allow read, write: if isSignedIn();
    }

    // Shared Invoices (Read-only public token access for clients)
    match /sharedInvoices/{shareToken} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }
  }
}
